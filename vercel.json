{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "buildCommand":"python3 scripts/build.py",
  "outputDirectory":"dist",
  "cleanUrls":true,
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"}]},{"source":"/news.json","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}]
}
